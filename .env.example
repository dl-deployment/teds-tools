# Copy to .env.local for local development, and set the same names in the
# Vercel project — for **both** Preview and Production. NEXT_PUBLIC_* values are
# inlined at build time, so changing one needs a redeploy.
#
# These are public by design. Watching a channel on /livelog needs no secret,
# and the *write* token belongs to the sending project, never to this app.

# REST base of the realtime server (see livelog-server/) — used by the page.
NEXT_PUBLIC_LIVELOG_URL=http://localhost:8787

# Viewer socket. Can be omitted when NEXT_PUBLIC_LIVELOG_URL is set — it is then
# derived as ws://…/ws or wss://…/ws from it. Must be wss:// in production: an
# HTTPS page cannot open a plain ws:// connection.
NEXT_PUBLIC_LIVELOG_WS_URL=ws://localhost:8787/ws

# Channels listed in the sub-sidebar, and the one selected on first load.
NEXT_PUBLIC_LIVELOG_CHANNELS=default
NEXT_PUBLIC_LIVELOG_DEFAULT_CHANNEL=default
